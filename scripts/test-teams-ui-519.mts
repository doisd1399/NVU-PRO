import assert from "node:assert/strict";
import fs from "node:fs";
import path from "node:path";
import { createServer } from "vite";
import react from "@vitejs/plugin-react";
import { chromium } from "playwright";
const root = process.cwd(), checks: string[] = [], metrics: Record<string, number> = {}, errors: string[] = [];
const server = await createServer({ configFile: false, root, plugins: [{ name: "isolated-read-model", enforce: "pre", load(id) {
  const clean = id.split("?")[0];
  if (["src/context/AppContext.tsx", "src/context/CompanyContext.tsx"].some(file => clean === path.join(root, file))) return 'export * from "/verification/release-519/teams-fixture.tsx";';
  if (clean === path.join(root, "src/hooks/useTripHistory.ts")) return 'export const useTripHistory=()=>({historicoTrips:[]});';
  if (clean === path.join(root, "src/services/fleetMembershipService.ts")) return 'export const prepareFleetMembership=async()=>{};';
  if (clean === path.join(root, "src/lib/firebase.ts")) return 'export const db={}; export const auth={currentUser:null}; export const functions={};';
} }, react()], server: { host: "127.0.0.1", port: 4199, strictPort: true, hmr: false } });
await server.listen();
const browser = await chromium.launch({ executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE, headless: true, args: ["--no-sandbox", "--disable-dev-shm-usage", "--disable-gpu"] });
const page = await browser.newPage({ viewport: { width: 430, height: 932 } });
page.on("pageerror", error => errors.push(error.message));
try {
  await page.route("**/*", route => /^http:\/\/127\.0\.0\.1:4199\//.test(route.request().url()) ? route.continue() : route.abort());
  await page.goto("http://127.0.0.1:4199/verification/release-519/teams.html");
  await page.getByText("Nome Cadastro", { exact: true }).waitFor();
  assert((await page.getByRole("img", { name: "Nome Cadastro NVU", exact: true }).getAttribute("src"))?.startsWith("data:image/svg"));
  assert.equal(await page.getByText("Nome Google", { exact: true }).count(), 0);
  checks.push("Actual Teams card uses the form identity and never the provider avatar");
  await page.getByRole("button", { name: "Ações de Nome Cadastro NVU" }).click();
  await page.getByRole("button", { name: "Remover da Frota", exact: true }).click();
  await page.getByRole("dialog", { name: "Remover da frota" }).waitFor();
  const start = Date.now(); await page.getByRole("button", { name: "Remover", exact: true }).click();
  await page.getByRole("dialog").waitFor({ state: "detached" });
  metrics.clickToDismissMs = Date.now() - start;
  await page.getByText("Atualizando vínculo…", { exact: true }).waitFor();
  assert.equal(await page.evaluate(() => (window as any).qa519.calls), 1);
  await page.evaluate(() => (window as any).qa519.finish(true));
  await page.getByRole("button", { name: "Ações de Nome Cadastro NVU", exact: true }).waitFor({ state: "detached" });
  await page.getByRole("button", { name: "Ações de Gestor", exact: true }).waitFor();
  assert.equal(await page.getByText("Nenhum motorista ativo", { exact: true }).count(), 0);
  checks.push("Removal modal closes immediately; pending status stays visible; ACK removes only the driver and preserves the owner");
  await page.evaluate(() => { (window as any).qa519.reset(); (window as any).qa519.edit(); });
  await page.getByText("Nome Editado", { exact: true }).waitFor();
  assert.equal(await page.getByRole("img", { name: "Nome Editado NVU", exact: true }).count(), 0);
  checks.push("Later NVU name edits and explicit photo removal stay authoritative in Teams");
  await page.evaluate(() => { (window as any).qa519.reset(); (window as any).qa519.pending(); });
  await page.getByRole("button", { name: "Aprovar", exact: true }).click();
  await page.getByRole("button", { name: "Aprovando...", exact: true }).waitFor();
  assert.equal(await page.evaluate(() => (window as any).qa519.approvals), 1);
  await page.evaluate(() => (window as any).qa519.approve());
  await page.getByText("Nome Cadastro", { exact: true }).waitFor();
  checks.push("Approval responds immediately, prevents repeat taps and updates the employee card after ACK");
  assert.deepEqual(errors, []);
  fs.mkdirSync("reports/release-519", { recursive: true });
  fs.writeFileSync("reports/release-519/teams-ui.json", JSON.stringify({ checks, metrics, errors, productionBenchmark: false, method: "Real DriversTab and display resolver in Chromium; injected company/session read model and manually controlled ACKs. No production traffic." }, null, 2));
  console.log("TEAMS_UI_519_PASS", checks.length, metrics);
} finally { await browser.close(); server.httpServer?.closeAllConnections(); await server.close(); }
