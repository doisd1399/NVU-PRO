 android.os.Handler mainHandler=new android.os.Handler();
 android.view.View bubbleView, statusChipView;
 android.widget.LinearLayout menuView;
 android.view.WindowManager.LayoutParams bubbleParams,menuParams,statusChipParams;
 Runnable statusChipHideRunnable;
 boolean destroying;
