import assert from "node:assert/strict";
import { driverQueuePresentation } from "../src/lib/driverQueuePresentation.ts";
import { queue477 } from "./fixtures/driver-queue-477-data.ts";

const ready = queue477(), original = JSON.stringify(ready);
const preview = driverQueuePresentation(ready);
assert.equal(preview.next?.id, "c14");
assert.deepEqual(preview.preview.map(item => item.id), ["c15", "c16", "c17", "c18"]);
assert.equal(preview.done, 13); assert.equal(preview.count, 20); assert.equal(preview.percent, 65);
assert.deepEqual(preview.items.map(item => item.id), ["c14", "c15", "c16", "c17", "c18", "c19", "c20"]);
assert([...preview.items, ...preview.preview, ...preview.upcoming].every(item => item.state !== "done"), "Completed operations cannot appear in either queue mode");
assert.equal(JSON.stringify(ready), original, "Projection cannot mutate the server snapshot");
const shuffled = queue477(); shuffled.items.reverse();
assert.deepEqual(driverQueuePresentation(shuffled).items.map(item => item.id), ready.items.filter(item => item.state !== "done").map(item => item.id));
const duplicateId = queue477();
duplicateId.queues.push({ ...duplicateId.queues[0], id: "q2", name: "Outra fila", count: 1, done: 0 });
duplicateId.items.push({ ...duplicateId.items[13], queueId: "q2", position: 0 });
const projected = driverQueuePresentation(duplicateId);
assert(projected.upcoming.some(item => item.id === "c14" && item.queueId === "q2"));
assert(!projected.isNext(duplicateId.items.at(-1)!));
const unknown = queue477(); unknown.items.unshift({ ...unknown.items[0], queueId: "not-in-view", state: "pending" });
assert(!driverQueuePresentation(unknown).items.some(item => item.queueId === "not-in-view"));
const review = queue477(); review.next = null; review.reason = "review";
review.items[13] = { ...review.items[13], state: "review", issue: "Conferir histórico" };
assert.equal(driverQueuePresentation(review).next, null);
assert.equal(driverQueuePresentation(review).preview[0].issue, "Conferir histórico");
const empty = queue477(); empty.queues = []; empty.items = []; empty.next = null; empty.reason = "no_queues";
assert.deepEqual(driverQueuePresentation(empty).items, []); assert.equal(driverQueuePresentation(empty).percent, 0);
const bounded = queue477(); bounded.queues[0].done = 200;
assert.equal(driverQueuePresentation(bounded).percent, 100);
const completed = queue477(); completed.items.forEach(item => { item.state = "done"; }); completed.queues[0].done = 20;
const finished = driverQueuePresentation(completed);
assert.deepEqual(finished.items, []); assert.deepEqual(finished.preview, []);
assert.equal(finished.next, null, "A stale next-operation pointer cannot offer a completed operation");
assert.equal(finished.isNext(completed.items[13]), false);
assert.equal(finished.done, 20); assert.equal(finished.count, 20); assert.equal(finished.percent, 100);
const changing = queue477(); changing.items[13].state = "done"; changing.queues[0].done = 14;
assert.equal(driverQueuePresentation(changing).next, null);
assert(!driverQueuePresentation(changing).items.some(item => item.id === "c14"), "A completed current preview disappears immediately on snapshot update");
assert.deepEqual(driverQueuePresentation(JSON.parse(JSON.stringify(changing))).items, driverQueuePresentation(changing).items, "Cached and live snapshots share the same queue filtering");
const active = queue477(); active.items[13].state = "current"; active.items[14].state = "unavailable";
assert(driverQueuePresentation(active).items.some(item => item.state === "current"));
assert(driverQueuePresentation(active).items.some(item => item.state === "unavailable"));
console.log("QUEUE_PRESENTATION_477 PASS: completed entries hidden in all modes, progress/history retained, stale next rejected, cached snapshots, ordering, non-mutation and multiple queues");
