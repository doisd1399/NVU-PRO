<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.stargamesapps.gto" />
        <package android:name="com.dynamicgames.worldtruckdrivingsimulator" />
        <package android:name="com.dynamicgames.worldbusdrivingsimulator" />
        <package android:name="com.WandaSoftware.TruckersofEurope3" />
    </queries>

    <!-- Existing network access -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GTO observer: explicit user-granted special access only. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Foreground observer and local screen analysis. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".GtoProjectionPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:taskAffinity=""
            android:launchMode="standard"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|density"
            android:theme="@style/AppTheme.GtoProjectionPermission" />

        <activity
            android:name=".SimpleAutomationProjectionPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:taskAffinity=""
            android:launchMode="standard"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|density"
            android:theme="@style/AppTheme.GtoProjectionPermission" />

        <service
            android:name=".GtoObserverService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="GTO-only floating trip observer explicitly enabled by the driver; keeps the NVU control visible while the simulator is foreground." />
        </service>

        <service
            android:name=".SimpleAutomationService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="NVU simple route control explicitly enabled by the driver; adds one-shot receipt capture only after the driver taps finish." />
        </service>
<provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
