rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageUpload(maxSizeBytes) {
      return request.resource != null &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < maxSizeBytes;
    }

    function isSenior() {
      return isAuthenticated() && (request.auth.token.get('senior', false) == true ||
        request.auth.token.get('isSenior', false) == true || request.auth.token.get('role', '') == 'senior' ||
        (request.auth.token.get('roles', []) is list && request.auth.token.get('roles', []).hasAny(['senior'])));
    }
    function accountIsUsable() {
      let path = /databases/(default)/documents/users/$(request.auth.uid);
      let user = firestore.exists(path) ? firestore.get(path).data : {};
      return firestore.exists(path) && user.get('deleted', false) != true &&
        !(user.get('status', 'active').lower() in ['suspended', 'deleted', 'blocked', 'disabled', 'inactive']) &&
        !(user.get('accountStatus', 'active').lower() in ['suspended', 'deleted', 'blocked', 'disabled', 'inactive']) &&
        user.get('suspension', {}).get('active', false) != true;
    }
    function companyAccess(companyId) {
      let path = /databases/(default)/documents/company_access/$(companyId)/members/$(request.auth.uid);
      return firestore.exists(path) ? firestore.get(path).data : {};
    }
    function belongsToCompany(companyId) {
      let access = companyAccess(companyId);
      // At most two distinct Firestore documents: own account and server-owned membership.
      return isAuthenticated() && accountIsUsable() && (isSenior() ||
        (access.get('status', '') == 'active' && access.get('revokedAt', null) == null));
    }
    function managesCompany(companyId) {
      return belongsToCompany(companyId) && (isSenior() || companyAccess(companyId).get('roles', []).hasAny(['admin', 'owner']));
    }
    function mayReadTripReceipt(companyId, userId) {
      return isAuthenticated() && accountIsUsable() && (request.auth.uid == userId || managesCompany(companyId));
    }

    // Covers are public identity media. Writing a driver's cover requires its
    // own UID; company covers require the same manager/owner boundary as frotas.
    match /profile-covers/{scope}/{profileId}/{userId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && isAuthenticated() && accountIsUsable() && request.auth.uid == userId &&
        isImageUpload(2000000) &&
        ((scope == 'driver' && profileId == request.auth.uid) ||
          (scope == 'company' && managesCompany(profileId)));
      allow update, delete: if false;
    }

    // Personal identity and company drafts are owned by a UID, not a tenant.
    // Only the subsequent Firestore write can publish a draft as company media.
    match /profile-photos/{userId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && isAuthenticated() && request.auth.uid == userId &&
        accountIsUsable() && isImageUpload(2000000);
      allow update, delete: if false;
    }
    match /company-logo-drafts/{userId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && isAuthenticated() && request.auth.uid == userId &&
        accountIsUsable() && isImageUpload(2000000);
      allow update, delete: if false;
    }

    // Public company-registration flow; uploads are deliberately small.
    match /empresas/company_registrations/recruitment_photos/{fileName} {
      allow read: if true;
      allow write: if resource == null && isImageUpload(500000);
    }

    // Receipts are readable only by their driver, company owner/manager or a
    // Senior/admin. Paths are trip-receipts/{companyId}/{userId}/{fileName}.
    match /trip-receipts/{companyId}/{userId}/{fileName} {
      allow read: if mayReadTripReceipt(companyId, userId);
      allow create: if resource == null && isAuthenticated() &&
        request.auth.uid == userId &&
        belongsToCompany(companyId) &&
        isImageUpload(2000000);
      allow update, delete: if false;
    }
    match /trip-receipts/{allPaths=**} {
      allow read, write: if false;
    }

    // Existing company/profile images remain publicly readable for public
    // profile pages, but writes must use the uploader's own UID path and tenant.
    match /empresas/{companyId}/{folder}/{userId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && companyId != 'company_registrations' &&
        isAuthenticated() &&
        request.auth.uid == userId &&
        belongsToCompany(companyId) &&
        isImageUpload(2000000);
      allow update, delete: if false;
    }
    match /empresas/{companyId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
