 await page.getByText('Gerenciar instalação',{exact:true}).click();await page.getByRole('button',{name:'Reinstalar plugin',exact:true}).click();assert.equal(effects.at(-1).method,'installPlugin');await page.getByRole('button',{name:'Remover plugin NVU',exact:true}).click();assert.equal(effects.at(-1).method,'removePlugin');
 await page.getByText('Ajuda com a conexão',{exact:true}).click();await page.getByRole('button',{name:'Consultar diagnóstico',exact:true}).click();await page.getByText('Detalhes para suporte',{exact:true}).waitFor();assert.equal(await page.locator('pre').isVisible(),false);
 await page.getByRole('button',{name:'Copiar diagnóstico',exact:true}).click();assert.equal(effects.at(-1).method,'copyDiagnostics');checks.push('Cancelamento de instalação/remoção respeitado; diagnóstico recolhido e cópia explícita');
 await page.getByRole('button',{name:'Viagem',exact:true}).click();assert.equal(await page.locator('.nvu-windows-settings').evaluate(e=>getComputedStyle(e).backgroundColor),'rgb(255, 255, 255)');
 if(process.env.NVU_QA_PRIVATE_SCREEN_DIR){fs.mkdirSync(process.env.NVU_QA_PRIVATE_SCREEN_DIR,{recursive:true});await page.screenshot({path:path.join(process.env.NVU_QA_PRIVATE_SCREEN_DIR,'settings-light.png')});}
 await page.evaluate(()=>window.__applyWindowsTheme('dark'));await page.waitForFunction(()=>document.getElementById('qa-app-theme').textContent==='dark');assert.equal(await page.evaluate(()=>localStorage.getItem('frotalog-theme')),'dark');await page.evaluate(()=>window.__applyWindowsTheme('invalid'));assert.equal(await page.locator('#qa-app-theme').textContent(),'dark');checks.push('Tema nativo aplica o store real NVU e persiste a preferência, recusando valor inválido');assert.equal(await page.locator('.nvu-windows-settings').evaluate(e=>getComputedStyle(e).backgroundColor),'rgb(26, 37, 45)');assert.equal(await entry.evaluate(e=>getComputedStyle(e).backgroundColor),'rgb(26, 37, 45)');
 if(process.env.NVU_QA_PRIVATE_SCREEN_DIR)await page.screenshot({path:path.join(process.env.NVU_QA_PRIVATE_SCREEN_DIR,'settings-dark.png')});
