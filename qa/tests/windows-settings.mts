 await page.getByRole('button',{name:'Como usar',exact:true}).click();await page.getByText('Ctrl + N',{exact:true}).waitFor();await page.getByRole('button',{name:'Fechar ajustes do PRO Windows',exact:true}).click();assert.equal(await page.getByRole('dialog',{name:'Assistente PRO Windows'}).count(),0);checks.push('Tokens de tema compartilhados, viewport estreito, ajuda e fechamento funcionais');
