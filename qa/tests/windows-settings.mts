 await page.getByRole('button',{name:'Ativar PRO',exact:true}).click();await page.getByRole('button',{name:'Voltar ao simulador',exact:true}).waitFor();assert(effects.some(e=>e.method==='start'&&e.value.jobId==='qa-operation'));assert.equal(effects.at(-1).method,'openGame');
 await page.getByRole('button',{name:'Pausar assistente',exact:true}).click();assert.equal(effects.at(-1).method,'pause');await page.getByRole('button',{name:'Encerrar PRO',exact:true}).click();assert.equal(effects.at(-1).method,'stop');
 await page.getByRole('button',{name:/Viagens da operação/}).click();assert.deepEqual(await page.evaluate(()=>window.__effects),['history']);checks.push('Abrir assistente, ativar, voltar, pausar, encerrar e histórico executam callbacks corretos');
