await context.addInitScript("globalThis.__name=(target)=>target;Object.defineProperty(navigator,'locks',{configurable:true,value:{request:()=>Promise.reject(new DOMException('Injected lock failure','AbortError'))}});");
await context.route('**/*',r=>/^https?:\/\/(127\.0\.0\.1|localhost):(4185|8085|9099|9199|5001)(\/|$)/.test(r.request().url())?r.continue():r.abort());const page=await context.newPage();page.on('pageerror',e=>errors.push(e.message));
try{
 await page.goto('http://127.0.0.1:4185/verification/release-515/recordtrip.html',{waitUntil:'domcontentloaded',timeout:60000});await page.getByRole('button',{name:'LANÇAR VIAGEM',exact:true}).waitFor({timeout:30000});await page.waitForFunction(()=>!document.querySelector('[inert]'));
 await page.getByRole('textbox',{name:'Origem da rota'}).fill('GA');await page.getByRole('textbox',{name:'Destino da rota'}).fill('SP');
 await page.locator('input[type="file"]').setInputFiles('verification/release-515/gto-10100.png');await page.getByText('10.100,00',{exact:true}).waitFor({timeout:90000});await page.getByText(/Leitura local concluída/).waitFor({timeout:90000});checks.push('Tela real extrai o valor com OCR real e preserva o comprovante');
 assert.equal(await page.getByRole('textbox',{name:'Origem da rota'}).inputValue(),'GA');assert.equal(await page.getByRole('textbox',{name:'Destino da rota'}).inputValue(),'SP');
 await context.setOffline(true);await page.getByRole('button',{name:'LANÇAR VIAGEM',exact:true}).click();await page.getByRole('status',{name:'Aguardando envio',exact:true}).first().waitFor({timeout:10000});
 const first=await page.evaluate(()=>JSON.parse(localStorage.getItem('nvu_canonical_trips.v2')!));const id=Object.keys(first.outbox)[0];assert(id);assert.equal(Object.keys(first.outbox).length,1);assert.equal(first.outbox[id].trip.valorCents,1010000);checks.push('Sem conexão e com falha no Web Locks, diário e histórico preservam uma viagem');
 await context.setOffline(false);await page.reload();await page.getByRole('button',{name:'HISTÓRICO DE VIAGENS',exact:true}).waitFor({timeout:30000});await page.waitForFunction(()=>!document.querySelector('[inert]'));await page.getByRole('button',{name:'HISTÓRICO DE VIAGENS',exact:true}).click();await page.getByRole('status',{name:'Aguardando envio',exact:true}).first().waitFor();
 const restored=await page.evaluate(()=>JSON.parse(localStorage.getItem('nvu_canonical_trips.v2')!));assert.equal(Object.keys(restored.outbox)[0],id);checks.push('Reabrir a página mantém a mesma tentativa e o mesmo comprovante');
 await page.evaluate(async()=>(window as any).__qa515.syncEngine.synchronize());await page.getByRole('status',{name:'Enviada',exact:true}).first().waitFor({timeout:40000});
 const history=await db.collection('historico_viagens').where('jobId','==','qa-job-515').get();assert.equal(history.size,1);assert.equal(history.docs[0].id,id);assert.equal(history.docs[0].get('valorCents'),1010000);assert.equal((await db.doc('trabalhos/qa-job-515').get()).get('progress'),1);assert.equal((await db.collection('trip_operation_slots').where('jobId','==','qa-job-515').get()).size,1);checks.push('Upload, HTTP callable, confirmação, histórico e progresso reais convergem sem duplicidade');
 await page.evaluate(async()=>(window as any).__qa515.syncEngine.synchronize());assert.equal((await db.collection('historico_viagens').where('jobId','==','qa-job-515').get()).size,1);checks.push('Nova sincronização não duplica o registro');
 assert.deepEqual(errors,[]);fs.writeFileSync('qa/results/emulators/print-ui.json',JSON.stringify({checks,errors,method:'RecordTrip/TripHistory reais, OCR real, IndexedDB e Auth/Firestore/Storage locais e handlers HTTP reais. Apenas o read model de conta/operação é fixado neste cenário. Não é o AppContext completo.'},null,2));console.log('QA_PRINT_UI_PASS',checks.length);
}catch(e){console.error((await page.locator('body').innerText()).slice(-5000));console.error(errors);throw e;}
finally{await context.setOffline(false);await browser.close();server.httpServer?.closeAllConnections();await server.close();http.closeAllConnections();await new Promise<void>(r=>http.close(()=>r()));await rules.cleanup();await db.terminate();}
