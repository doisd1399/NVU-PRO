 'users/qa-print-515':{name:'Motorista QA',email:'qa515@example.test',status:'active',role:'driver',roles:['driver'],companyId:'qa-company-515'},
 'frotas/qa-company-515':{ownerId:'qa-owner-515',userId:'qa-owner-515',companyName:'Empresa QA',status:'active',simulatorId:'gto'},
