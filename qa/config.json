  "steps": {
    "types": {
      "label": "Tipos e compilação do aplicativo",
      "kind": "static",
      "args": [
        "node_modules/typescript/bin/tsc",
        "--noEmit"
      ],
      "timeoutMs": 120000
    },
    "functions": {
      "label": "Compilação do servidor",
      "kind": "build",
      "args": [
        "functions/node_modules/typescript/bin/tsc",
        "--project",
        "functions/tsconfig.json"
      ],
      "timeoutMs": 120000
    },
    "web-build": {
      "label": "Build Web atual",
      "kind": "build",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "timeoutMs": 180000
    },
    "contracts": {
      "label": "Upload, confirmação, identidade e autorização",
      "kind": "controlled",
      "args": [
        "--import",
        "tsx",
        "scripts/test-performance-520.mts"
      ],
      "timeoutMs": 60000
    },
    "queue": {
      "label": "Fila, falhas, reconexão e preservação das viagens",
      "kind": "controlled",
      "args": [
        "--import",
        "tsx",
        "scripts/test-trip-recovery-520.mts"
      ],
      "timeoutMs": 90000
    },
    "supervisor": {
      "label": "Envio sem bloqueio por operações antigas",
      "kind": "controlled",
      "args": [
        "--import",
        "tsx",
        "scripts/test-sync-supervisor-520.mts"
      ],
      "timeoutMs": 30000
    },
    "images": {
      "label": "Imagens persistentes, reabertura e isolamento",
