# Android/Gradle generated outputs and caches (all modules)
**/build/
.gradle/
**/.gradle/
local.properties
.release-work/
.apk-integrity-tmp/

# APK/AAB/APKS are delivery artifacts, never project source
*.apk
*.aab
*.apks
dist-apk/
.ci-delivery/
.ci-evidence/

# Capacitor sync assets are regenerated from source before a Release
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/assets/public/*
!android/app/src/main/assets/public/.gitkeep

# Private release inputs -- never commit
android/app/google-services.json
*.jks
*.keystore
*.p12
*.pem
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.iml

